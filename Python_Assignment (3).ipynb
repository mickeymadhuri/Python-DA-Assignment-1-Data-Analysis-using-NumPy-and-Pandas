        "\n",
        "import pandas as pd\n",
        "\n",
        "# Step 1: Creating Pandas Series\n",
        "marks = pd.Series(\n",
        "    [95, 92, 89, 85, 80],\n",
        "    index=['Rank1', 'Rank2', 'Rank3', 'Rank4', 'Rank5']\n",
        ")\n",
        "\n",
        "print(\"Marks Series:\")\n",
        "print(marks)\n",
        "\n",
        "# Step 2: Indexing and Slicing\n",
        "\n",
        "# Access 1st rank using integer index\n",
        "print(\"1st Rank Mark:\", marks[0])\n",
        "\n",
        "# Retrieve top 3 ranks using loc\n",
        "print(\"Top 3 Ranks:\")\n",
        "print(marks.loc[['Rank1', 'Rank2', 'Rank3']])\n",
        "\n",
        "# Retrieve 3rd rank using iloc\n",
        "print(\"3rd Rank Mark:\", marks.iloc[2])\n",
        "\n",
        "# Boolean mask: Marks greater than 90\n",
        "filtered_marks = marks[marks > 90]\n",
        "print(\"Marks Greater Than 90:\")\n",
        "print(filtered_marks)\n",
        "\n",
        "# Step 3: Manipulating Series\n",
        "\n",
        "# Modify 1st rank mark to 100\n",
        "marks['Rank1'] = 100\n",
        "print(\"Updated Marks:\")\n",
        "print(marks)\n",
        "\n",
        "# Remove last rank\n",
        "marks = marks.drop('Rank5')\n",
        "print(\"Marks After Removing Rank5:\")\n",
        "print(marks)\n",
        "\n",
        "# Compute CGPA\n",
        "cgpa = marks / 10\n",
        "print(\"CGPA:\")\n",
        "print(cgpa)\n"
      ],
