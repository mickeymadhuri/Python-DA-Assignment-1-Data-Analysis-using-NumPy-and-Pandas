        "\n",
        "import pandas as pd\n",
        "\n",
        "# Step 1: Creating Pandas DataFrame\n",
        "transactions = pd.DataFrame({\n",
        "    'TransactionID': [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],\n",
        "    'ProductCategory': [\n",
        "        'Electronics', 'Clothing', 'Electronics', 'Furniture',\n",
        "        'Clothing', 'Electronics', 'Furniture', 'Clothing',\n",
        "        'Furniture', 'Electronics'\n",
        "    ],\n",
        "    'Region': [\n",
        "        'North', 'South', 'North', 'East', 'West',\n",
        "        'North', 'East', 'West', 'South', 'North'\n",
        "    ],\n",
        "    'Amount': [200, 150, 300, 450, 200, 250, 300, 180, 350, 400]\n",
        "})\n",
        "\n",
        "print(\"Transactions DataFrame:\")\n",
        "print(transactions)\n",
        "\n",
        "# Step 2: Data Exploration\n",
        "\n",
        "# Display head\n",
        "print(\"First 5 Rows:\")\n",
        "print(transactions.head())\n",
        "\n",
        "# Display tail\n",
        "print(\"Last 5 Rows:\")\n",
        "print(transactions.tail())\n",
        "\n",
        "# Shape\n",
        "print(\"Shape:\", transactions.shape)\n",
        "\n",
        "# Column names\n",
        "print(\"Column Names:\", transactions.columns)\n",
        "\n",
        "# Data types\n",
        "print(\"Data Types:\")\n",
        "print(transactions.dtypes)\n",
        "\n",
        "# Basic information\n",
        "transactions.info()\n",
        "\n",
        "# Display ProductCategory and Amount\n",
        "print(\"ProductCategory and Amount:\")\n",
        "print(transactions[['ProductCategory', 'Amount']])\n",
        "\n",
        "# Retrieve last 3 columns using iloc\n",
        "print(\"Last 3 Columns:\")\n",
        "print(transactions.iloc[:, -3:])\n",
        "\n",
        "# Filter Region North and Amount > 200\n",
        "filtered_data = transactions[\n",
        "    (transactions['Region'] == 'North') &\n",
        "    (transactions['Amount'] > 200)\n",
        "]\n",
        "print(\"Filtered Data:\")\n",
        "print(filtered_data)\n",
        "\n",
        "# Value counts\n",
        "print(\"ProductCategory Value Counts:\")\n",
        "print(transactions['ProductCategory'].value_counts())\n",
        "\n",
        "# Unique regions\n",
        "print(\"Unique Regions:\")\n",
        "print(transactions['Region'].unique())\n",
        "\n",
        "# Group by Region and calculate mean\n",
        "print(\"Mean Amount by Region:\")\n",
        "print(transactions.groupby('Region')['Amount'].mean())\n",
        "\n",
        "# Step 3: Manipulating DataFrame\n",
        "\n",
        "# Modify Amount for TransactionID 102\n",
        "transactions.loc[\n",
        "    transactions['TransactionID'] == 102, 'Amount'\n",
        "] = 165\n",
        "\n",
        "print(\"Updated Amount:\")\n",
        "print(transactions)\n",
        "\n",
        "# Add Discount column\n",
        "transactions['Discount'] = transactions['Amount'] * 0.10\n",
        "\n",
        "print(\"After Adding Discount:\")\n",
        "print(transactions)\n",
        "\n",
        "# Remove TransactionID 109\n",
        "transactions = transactions.drop(\n",
        "    transactions[transactions['TransactionID'] == 109].index\n",
        ")\n",
        "\n",
        "print(\"After Removing TransactionID 109:\")\n",
        "print(transactions)\n",
        "\n",
        "# Delete Discount column\n",
        "transactions = transactions.drop(columns=['Discount'])\n",
        "\n",
        "print(\"Final DataFrame:\")\n",
        "print(transactions)\n"
      ],
