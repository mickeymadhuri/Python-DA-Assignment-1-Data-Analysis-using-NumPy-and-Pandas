        "\n",
        "import numpy as np\n",
        "\n",
        "# Step 5: Create a 2D NumPy Array\n",
        "temperatures = np.array([\n",
        "    [22.5, 25.3, 20.8, 23.4, 26.1, 24.8, 21.9],\n",
        "    [19.2, 22.5, 21.3, 24.0, 23.5, 22.8, 20.1]\n",
        "])\n",
        "\n",
        "print(\"Temperatures:\")\n",
        "print(temperatures)\n",
        "\n",
        "# Step 6: Inspect Array Properties\n",
        "print(\"Shape:\", temperatures.shape)\n",
        "print(\"Data Type:\", temperatures.dtype)\n",
        "print(\"Total Number of Elements:\", temperatures.size)\n",
        "\n",
        "# Extract Week 1 Temperatures\n",
        "week1 = temperatures[0]\n",
        "print(\"Week 1 Temperatures:\", week1)\n",
        "\n",
        "# Extract Week 2 Temperatures\n",
        "week2 = temperatures[1]\n",
        "print(\"Week 2 Temperatures:\", week2)\n",
        "\n",
        "# Extract Weekend Temperatures for Both Weeks\n",
        "weekend = temperatures[:, -2:]\n",
        "print(\"Weekend Temperatures:\")\n",
        "print(weekend)\n",
        "\n",
        "# Extract Week 1 Weekend Temperatures\n",
        "week1_weekend = temperatures[0, -2:]\n",
        "print(\"Week 1 Weekend:\", week1_weekend)\n",
        "\n",
        "# Extract Week 2 Weekend Temperatures\n",
        "week2_weekend = temperatures[1, -2:]\n",
        "print(\"Week 2 Weekend:\", week2_weekend)\n"
